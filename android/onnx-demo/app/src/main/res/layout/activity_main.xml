<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="菲比 · ONNX"
        android:textColor="@color/paper"
        android:textSize="32sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sentence"
        android:textColor="@color/muted"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/casePath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="monospace"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/pickZip"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/amber"
        android:text="@string/pick_zip"
        android:textColor="@color/ink"
        android:textSize="18sp" />

    <Button
        android:id="@+id/openPackage"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/open_package"
        android:textSize="15sp" />

    <Button
        android:id="@+id/pickFolder"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/pick_folder"
        android:textSize="15sp" />

    <Button
        android:id="@+id/download"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/download"
        android:textSize="15sp" />

    <Button
        android:id="@+id/synthesize"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/synthesize"
        android:textSize="18sp" />

    <Button
        android:id="@+id/copyLog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/copy_log"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:background="@color/ink_soft"
        android:fillViewport="true"
        android:padding="12dp">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/paper"
            android:textSize="13sp" />
    </ScrollView>
</LinearLayout>
