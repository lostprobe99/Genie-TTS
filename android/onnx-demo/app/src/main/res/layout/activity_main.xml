<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="Genie"
        android:textColor="@color/paper"
        android:textSize="32sp" />

    <EditText
        android:id="@+id/sentence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/ink_soft"
        android:gravity="top"
        android:hint="@string/sentence_hint"
        android:importantForAutofill="no"
        android:inputType="textMultiLine|textCapSentences"
        android:minLines="2"
        android:padding="12dp"
        android:text="@string/sentence"
        android:textColor="@color/paper"
        android:textColorHint="@color/muted"
        android:textSize="16sp" />

    <Spinner
        android:id="@+id/characters"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@color/ink_soft"
        android:popupBackground="@color/ink_soft" />

    <TextView
        android:id="@+id/casePath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/paramsToggle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:textColor="@color/amber"
        android:textSize="16sp" />

    <ScrollView
        android:id="@+id/paramsPanel"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/speedLabel"
                style="@style/ParamLabel" />

            <SeekBar
                android:id="@+id/speed"
                style="@style/ParamSeek"
                android:max="16"
                android:progress="8" />

            <TextView
                android:id="@+id/temperatureLabel"
                style="@style/ParamLabel" />

            <SeekBar
                android:id="@+id/temperature"
                style="@style/ParamSeek"
                android:max="26"
                android:progress="16" />

            <TextView
                android:id="@+id/topKLabel"
                style="@style/ParamLabel" />

            <SeekBar
                android:id="@+id/topK"
                style="@style/ParamSeek"
                android:max="29"
                android:progress="14" />

            <TextView
                android:id="@+id/penaltyLabel"
                style="@style/ParamLabel" />

            <SeekBar
                android:id="@+id/penalty"
                style="@style/ParamSeek"
                android:max="20"
                android:progress="7" />

            <TextView
                android:id="@+id/minSentenceLabel"
                style="@style/ParamLabel" />

            <SeekBar
                android:id="@+id/minSentence"
                style="@style/ParamSeek"
                android:max="19"
                android:progress="4" />

            <TextView
                android:id="@+id/maxSentenceLabel"
                style="@style/ParamLabel" />

            <SeekBar
                android:id="@+id/maxSentence"
                style="@style/ParamSeek"
                android:max="70"
                android:progress="30" />

            <TextView
                android:id="@+id/maxStepsLabel"
                style="@style/ParamLabel" />

            <SeekBar
                android:id="@+id/maxSteps"
                style="@style/ParamSeek"
                android:max="35"
                android:progress="20" />

            <TextView
                android:id="@+id/threadsLabel"
                style="@style/ParamLabel" />

            <SeekBar
                android:id="@+id/threads"
                style="@style/ParamSeek"
                android:max="8"
                android:progress="0" />

            <CheckBox
                android:id="@+id/leadingPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/amber"
                android:checked="true"
                android:text="@string/leading_period"
                android:textColor="@color/paper"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/pickZip"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/amber"
        android:text="@string/pick_zip"
        android:textColor="@color/ink"
        android:textSize="18sp" />

    <Button
        android:id="@+id/downloadProsody"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/download_prosody"
        android:textSize="15sp" />

    <Button
        android:id="@+id/synthesize"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/synthesize"
        android:textSize="18sp" />

    <Button
        android:id="@+id/copyLog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:text="@string/copy_log"
        android:textSize="15sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:background="@color/ink_soft"
        android:fillViewport="true"
        android:padding="12dp">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/paper"
            android:textSize="13sp" />
    </ScrollView>
</LinearLayout>
