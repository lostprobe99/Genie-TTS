<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/dp_14"
        android:paddingTop="@dimen/dp_14"
        android:paddingEnd="@dimen/dp_14"
        android:paddingBottom="@dimen/dp_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_prosody_card"
            android:elevation="@dimen/dp_2"
            android:orientation="vertical"
            android:padding="@dimen/dp_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/dp_44"
                    android:layout_height="@dimen/dp_44"
                    android:background="@drawable/bg_prosody_icon">

                    <ImageView
                        android:layout_width="@dimen/dp_24"
                        android:layout_height="@dimen/dp_24"
                        android:layout_gravity="center"
                        android:contentDescription="@string/prosody"
                        android:src="@drawable/ic_prosody_bars" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prosody_name"
                        android:textColor="@color/text_main"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/prosodyModel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/prosodyStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:background="@drawable/bg_prosody_idle"
                    android:paddingStart="@dimen/dp_8"
                    android:paddingTop="@dimen/dp_3"
                    android:paddingEnd="@dimen/dp_8"
                    android:paddingBottom="@dimen/dp_3"
                    android:text="@string/prosody_missing"
                    android:textColor="@color/text_sub"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                android:background="@drawable/bg_prosody_blurb"
                android:orientation="horizontal"
                android:padding="@dimen/dp_10">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spark"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_6"
                    android:layout_weight="1"
                    android:lineSpacingExtra="@dimen/dp_2"
                    android:text="@string/prosody_blurb"
                    android:textColor="@color/teal_ink"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_14"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/dp_4"
                    android:layout_weight="1"
                    android:background="@drawable/bg_prosody_meta"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_8">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prosody_file"
                        android:textColor="@color/slate"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/prosodyFile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_main"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_4"
                    android:layout_weight="1"
                    android:background="@drawable/bg_prosody_meta"
                    android:orientation="vertical"
                    android:padding="@dimen/dp_8">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prosody_size"
                        android:textColor="@color/slate"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/prosodySize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:fontFamily="monospace"
                        android:text="@string/prosody_missing"
                        android:textColor="@color/text_main"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:background="@drawable/bg_prosody_meta"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/dp_8"
                android:paddingTop="@dimen/dp_8"
                android:paddingEnd="@dimen/dp_4"
                android:paddingBottom="@dimen/dp_8">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prosody_path"
                        android:textColor="@color/slate"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/prosodyPath"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:fontFamily="monospace"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/prosodyCopy"
                    android:layout_width="@dimen/dp_36"
                    android:layout_height="@dimen/dp_36"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/prosody_copy_path"
                    android:src="@drawable/ic_copy" />
            </LinearLayout>

            <TextView
                android:id="@+id/prosodyUpdated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_10"
                android:textColor="@color/slate"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_4"
            android:layout_marginTop="@dimen/dp_18"
            android:layout_marginBottom="@dimen/dp_8"
            android:letterSpacing="0.04"
            android:text="@string/prosody_actions"
            android:textColor="@color/text_sub"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_prosody_card"
            android:elevation="@dimen/dp_2"
            android:orientation="vertical"
            android:padding="@dimen/dp_14">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="@dimen/dp_40"
                    android:layout_height="@dimen/dp_40"
                    android:background="@drawable/bg_prosody_github">

                    <ImageView
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:layout_gravity="center"
                        android:contentDescription="@string/prosody_download_title"
                        android:src="@drawable/ic_github" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/prosody_download_title"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/prosodyDownloadSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_2"
                        android:textColor="@color/text_sub"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/downloadProsody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:background="@drawable/bg_prosody_download"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="@dimen/dp_14"
                    android:paddingTop="@dimen/dp_7"
                    android:paddingEnd="@dimen/dp_14"
                    android:paddingBottom="@dimen/dp_7"
                    android:text="@string/download"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/prosodyDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/prosodyProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_6"
                android:layout_marginTop="@dimen/dp_8"
                android:indeterminate="false"
                android:indeterminateTint="@color/primary"
                android:max="1000"
                android:maxHeight="@dimen/dp_6"
                android:minHeight="@dimen/dp_6"
                android:progress="0"
                android:progressBackgroundTint="@color/border"
                android:progressTint="@color/primary"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@drawable/bg_prosody_card"
            android:elevation="@dimen/dp_2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/dp_14">

            <FrameLayout
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:background="@drawable/bg_prosody_icon">

                <ImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="center"
                    android:contentDescription="@string/prosody_import_title"
                    android:src="@drawable/ic_role_export"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prosody_import_title"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:text="@string/prosody_import_sub"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/importProsody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:background="@drawable/bg_import_cancel"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/dp_12"
                android:paddingTop="@dimen/dp_7"
                android:paddingEnd="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_7"
                android:text="@string/prosody_pick"
                android:textColor="@color/text_main"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/prosodyDeleteCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:background="@drawable/bg_prosody_danger_card"
            android:elevation="@dimen/dp_2"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/dp_14"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:background="@drawable/bg_prosody_rose_icon">

                <ImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:layout_gravity="center"
                    android:contentDescription="@string/prosody_delete_title"
                    android:src="@drawable/ic_role_trash"
                    app:tint="@color/rose" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prosody_delete_title"
                    android:textColor="@color/rose_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_2"
                    android:text="@string/prosody_delete_sub"
                    android:textColor="@color/rose_soft"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/deleteProsody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:background="@drawable/bg_prosody_remove"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="@dimen/dp_12"
                android:paddingTop="@dimen/dp_7"
                android:paddingEnd="@dimen/dp_12"
                android:paddingBottom="@dimen/dp_7"
                android:text="@string/prosody_remove"
                android:textColor="@color/rose"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_14"
            android:background="@drawable/bg_prosody_card"
            android:elevation="@dimen/dp_2"
            android:orientation="vertical"
            android:padding="@dimen/dp_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:contentDescription="@string/prosody_about_title"
                    android:src="@drawable/ic_nav_help"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:text="@string/prosody_about_title"
                    android:textColor="@color/text_main"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/dp_6"
                    android:layout_height="@dimen/dp_6"
                    android:layout_marginTop="@dimen/dp_6"
                    android:background="@drawable/bg_prosody_dot" />

                <TextView
                    android:id="@+id/prosodyTipWhat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:lineSpacingExtra="@dimen/dp_2"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:orientation="horizontal">

                <View
                    android:layout_width="@dimen/dp_6"
                    android:layout_height="@dimen/dp_6"
                    android:layout_marginTop="@dimen/dp_6"
                    android:background="@drawable/bg_prosody_dot" />

                <TextView
                    android:id="@+id/prosodyTipNet"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_weight="1"
                    android:lineSpacingExtra="@dimen/dp_2"
                    android:textColor="@color/text_sub"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="@dimen/dp_8"
                android:layout_height="@dimen/dp_8"
                android:background="@drawable/bg_prosody_dot" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_8"
                android:text="@string/prosody_footer"
                android:textColor="@color/slate"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
