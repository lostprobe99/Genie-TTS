<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_40"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/dp_4"
    android:paddingTop="@dimen/dp_8"
    android:paddingEnd="@dimen/dp_4"
    android:paddingBottom="@dimen/dp_8">

    <TextView
        android:id="@+id/sentenceIndex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:gravity="center"
        android:minWidth="@dimen/dp_20"
        android:minHeight="@dimen/dp_20"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/sentenceText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="1"
        android:paddingStart="@dimen/dp_8"
        android:paddingEnd="@dimen/dp_8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/sentenceDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:textSize="11sp" />

    <ImageButton
        android:id="@+id/sentencePlay"
        android:layout_width="@dimen/dp_24"
        android:layout_height="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_8"
        android:contentDescription="@string/play_sentence"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="@dimen/dp_4"
        android:scaleType="center"
        android:src="@drawable/ic_role_play"
        android:visibility="gone" />
</LinearLayout>
