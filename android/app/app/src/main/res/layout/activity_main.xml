                <LinearLayout
                    android:id="@+id/openProsody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dp_20"
                    android:paddingTop="@dimen/dp_14"
                    android:paddingEnd="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_14">

                    <ImageView
                        android:layout_width="@dimen/dp_22"
                        android:layout_height="@dimen/dp_22"
                        android:src="@drawable/ic_nav_prosody" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_16"
                        android:layout_weight="1"
                        android:text="@string/prosody"
                        android:textColor="@color/text_main"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/drawerProsodyState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill"
                        android:paddingStart="@dimen/dp_8"
                        android:paddingTop="@dimen/dp_2"
                        android:paddingEnd="@dimen/dp_8"
                        android:paddingBottom="@dimen/dp_2"
                        android:textColor="@color/primary"
                        android:textSize="11sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:background="@color/mist" />

                <LinearLayout
                    android:id="@+id/openHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dp_20"
                    android:paddingTop="@dimen/dp_14"
                    android:paddingEnd="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_14">

                    <ImageView
                        android:layout_width="@dimen/dp_22"
                        android:layout_height="@dimen/dp_22"
                        android:src="@drawable/ic_nav_help" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_16"
                        android:layout_weight="1"
                        android:text="@string/help"
                        android:textColor="@color/text_main"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/openLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dp_20"
                    android:paddingTop="@dimen/dp_14"
                    android:paddingEnd="@dimen/dp_16"
                    android:paddingBottom="@dimen/dp_14">

                    <ImageView
                        android:layout_width="@dimen/dp_22"
                        android:layout_height="@dimen/dp_22"
                        android:src="@drawable/ic_nav_log" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/dp_16"
                        android:layout_weight="1"
                        android:text="@string/view_log"
                        android:textColor="@color/text_main"
                        android:textSize="15sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1"
                    android:background="@color/mist" />

                <LinearLayout
                    android:id="@+id/openAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/dp_20"
                    android:paddingTop="@dimen/dp_14"
                    android:paddingEnd="@dimen/dp_16"
