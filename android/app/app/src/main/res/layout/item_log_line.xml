<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/dp_10"
    android:paddingTop="@dimen/dp_8"
    android:paddingEnd="@dimen/dp_10"
    android:paddingBottom="@dimen/dp_8">

    <View
        android:id="@+id/logRowDivider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:layout_marginBottom="@dimen/dp_8"
        android:background="@color/mist" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/logRowDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/slate"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/logRowTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/slate"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/logRowLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"
            android:paddingStart="@dimen/dp_6"
            android:paddingTop="@dimen/dp_1"
            android:paddingEnd="@dimen/dp_6"
            android:paddingBottom="@dimen/dp_1"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/logRowModule"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_6"
            android:layout_weight="1"
            android:textColor="@color/slate_strong"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/logRowIndex"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/slate"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/logRowMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/dp_2"
        android:paddingTop="@dimen/dp_4"
        android:textColor="@color/slate_strong"
        android:textSize="12sp" />
</LinearLayout>
